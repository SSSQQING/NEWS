{
  "name": "qingtu",
  "productName": "轻图",
  "version": "1.0.0",
  "description": "好看又好用的批量图片压缩 / 裁切工具",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "app.qingtu.imagecompressor",
    "productName": "轻图",
    "executableName": "Qingtu",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Qingtu-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Qingtu-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.photography",
      "icon": "build/icon.png",
      "artifactName": "Qingtu-${version}-${arch}.${ext}",
      "identity": "-"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "artifactName": "Qingtu-${version}.${ext}"
    }
  },
  "author": "Qingtu"
}
